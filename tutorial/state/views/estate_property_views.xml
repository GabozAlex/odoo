<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. ACCIÓN: El vínculo entre el menú y el modelo -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Propiedades</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera propiedad!
            </p>
            <p>
                Gestiona tus propiedades de forma sencilla.
            </p>
        </field>
    </record>

    <!-- 2. VISTA DE LISTA (antes 'tree') -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="garage"/>
                <field name="garden"/>
                <field name="active"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- 3. VISTA DE FORMULARIO -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="postcode"/>
                        <field name="date_availability"/>
                    </group>
                    <group>
                        <field name="expected_price"/>
                        <field name="selling_price" readonly="1"/>
                        <field name="bedrooms"/>
                        <field name="living_area"/>
                        <field name="facade"/>
                    </group>
                    <group>
                        <field name="garage"/>
                        <field name="garden"/>
                        <field name="garden_area"/>
                        <field name="garden_orientation"/>
                    </group>
                    <group>
                        <field name="active"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. MENÚS PRINCIPALES -->
    <menuitem id="menu_estate_root" name="Real Estate" sequence="10"/>
    <menuitem id="menu_estate_property" name="Propiedades" parent="menu_estate_root" action="action_estate_property" sequence="1"/>

</odoo>